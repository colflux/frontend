# Copiar a .env (gitignoreado) y completar con los valores reales.
# Vite incrusta estas variables en el bundle al momento del build
# (docker compose --profile prod build) — cambiarlas requiere rebuildear.

# Base de la API REST del backend (Django). En producción, nginx en el
# mismo servidor enruta /api/ hacia el backend, así que puede ser relativa.
VITE_API_BASE_URL=/api

# Base de la API de geodatos del backend.
VITE_GEO_API_BASE_URL=/api/geo

# Base de la API de reportes agregados (biomasa/COS/MOM) del backend.
VITE_REPORTES_API_BASE_URL=/api/reportes

# URL base de la API del asistente RAG (POST /chat, POST /ingest).
# ia-functions todavía no está desplegado (2026-09) — placeholder por ahora.
VITE_API_URL=http://localhost:8001

# Estilo del mapa (MapLibre).
VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Puerto publicado en el host — cambiar si ya está ocupado por otro
# proyecto en el mismo servidor.
FRONTEND_PORT=3000
